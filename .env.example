# ===== 必填 =====
# 从 @BotFather 获取的 Bot Token
TELEGRAM_BOT_TOKEN=

# ===== Cline API =====
# API 根地址
CLINEPASS_API_BASE=https://api.cline.bot
# 额度接口路径（官方 ClinePass 额度接口，返回 five_hour / weekly / monthly 三个窗口）
CLINEPASS_USAGE_PATH=/api/v1/users/me/plan/usage-limits
# 单次请求超时（秒）
REQUEST_TIMEOUT=12
# 429/5xx/网络错误的重试次数与退避基数（秒）
HTTP_RETRIES=2
RETRY_BACKOFF=1.5
# 同时查询的账号数
MAX_PARALLEL=4

# ===== Bot 行为 =====
# 每个用户最多保存多少个 Key
MAX_KEYS_PER_USER=10
# /status 的冷却时间（秒），防止刷接口
STATUS_COOLDOWN=5
# 单条消息最大长度（Telegram 上限 4096，一般不用改）
MESSAGE_LIMIT=3800
# 白名单：留空表示所有人都能用；多个 ID 用逗号分隔，可用 /id 查询
ALLOWED_USER_IDS=
# 演示模式：1 = 不请求额度接口，用示例数字渲染面板（仅用于截图/开发）
DEMO_MODE=0
# 是否在面板里显示账号邮箱与名字：默认 0（不显示，属敏感信息；日志里也会被脱敏）
SHOW_IDENTITY=0
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ===== 存储 =====
# 配置文件路径；容器内保持默认即可，本地运行留空则用脚本同目录的 config.json
CONFIG_FILE=
